---
import { css } from "styled-system/css";
import Layout from "./Layout.astro";
import Breadcrumb, {
  type BreadcrumbItem
} from "src/components/Breadcrumb.astro";
import type { Props as HeadProps } from "src/components/Head.astro";

const mainPageStyles = css({
  width: "full",
  margin: "0 auto",
  padding: { base: "4", md: "6" },
  display: "flex",
  flexDirection: "column",
  gap: { base: 6, md: 8 }
});

const narrowStyles = css({
  maxWidth: "3xl"
});

const pageTitleStyles = css({
  fontSize: { base: "2xl", md: "3xl" },
  fontWeight: "bold",
  textAlign: "center",
  letterSpacing: "tight"
});

const containerStyle = css({
  w: "full",
  h: "full",
  display: "grid"
});

interface Props extends HeadProps {
  pageTitle: string;
  // 記事詳細など、h1を本文側で描画する場合は false
  showTitle?: boolean;
  // 読みやすい幅に絞らず、横幅いっぱいに使う (Works一覧など)
  wide?: boolean;
  // HOME 以降のパンくず。省略するとパンくずを表示しない
  breadcrumbs?: BreadcrumbItem[];
}

const {
  pageTitle = "Works",
  showTitle = true,
  wide = false,
  breadcrumbs,
  ...headProps
} = Astro.props;
---

<Layout title={pageTitle} {...headProps}>
  <main class={wide ? mainPageStyles : `${mainPageStyles} ${narrowStyles}`}>
    {breadcrumbs && <Breadcrumb items={breadcrumbs} />}
    {showTitle && <h1 class={pageTitleStyles}>{pageTitle}</h1>}
    <div class={containerStyle}>
      <slot />
    </div>
  </main>
</Layout>

<style is:global>
  @keyframes customAnim {
    0% {
      filter: brightness(0);
    }
    50% {
      filter: brightness(0);
    }
    100% {
      filter: brightness(1);
    }
  }
</style>
