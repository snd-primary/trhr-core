---
import { css } from "styled-system/css";
import PageLayout from "src/layouts/PageLayout.astro";
import MemoCard from "src/components/content/MemoCard.astro";
import { getMemos } from "src/lib/content";

export const prerender = true;

const memos = await getMemos();
---

<PageLayout
  pageTitle="Memo"
  description="思いついたこと、気になること、覚えておきたいことの公開メモ"
  breadcrumbs={[{ label: "MEMO" }]}
>
  {memos.length > 0 ? (
    <div class={css({ display: "grid", gap: 3 })}>
      {memos.map((memo) => (
        <MemoCard memo={memo} />
      ))}
    </div>
  ) : (
    <p class={css({ textAlign: "center", color: "mutedForeground" })}>
      まだメモがありません。
    </p>
  )}
</PageLayout>
