---
import { css } from "../../styled-system/css";
import Layout from "../layouts/Layout.astro";

import MySkill from "src/components/ui/MySkill.astro";
import CardLayout from "../layouts/CardLayout.astro";

import SnsLinks from "src/components/ui/SnsLinks.astro";
import BlogMotif from "src/components/ui/BlogMotif.astro";
import Abouts from "src/components/ui/Abouts.astro";
import Career from "src/components/ui/Career.astro";
import KeyboardMotif from "src/components/ui/KeyboardMotif.astro";

export const prerender = true;

const itemHeight = 350;
const row = 3;
const initialGridStyles = css({
  display: "grid",
  gridTemplate: `
    "c1" auto 
    "c8" auto
    "c4" auto
    "c5" auto
    "c2" auto
    "c7" auto / 1fr
  `,
  lg: {
    gridTemplate: `
    "c1 c1" 1fr
    "c8 c8" auto
    "c5 c2" auto
    "c4 c4"  800px  
    "c7 c7"  auto / 1fr 1fr`,
    gap: 3
  },
  xl: {
    gridTemplate: `
    "c1 c1 c8 c8" 350px
    "c1 c1 c8 c8" 250px
    "c4 c4 c4 c2" 800px
    "c5 c5 c7 c7"  310px / 1fr 1fr 1fr 1fr
  `
  },
  width: "full",
  height: `calc(${row} * ${itemHeight})`,
  gap: 4
});
---

<Layout
  title="About"
  description="フロントエンドエンジニア TRHR のプロフィール、スキル、経歴"
>
  <main
    class={css({
      w: "full",
      h: "full",
      padding: { base: 3, sm: 4 },
      mt: 8,
      display: "grid",
      gridTemplateColumns: "1fr",
      gap: "12",
      md: {
        gap: "4"
      }
    })}
  >
    <div class={initialGridStyles}>
      <CardLayout title="ABOUT" area="c1">
        <Abouts />
      </CardLayout>
      <CardLayout title="BLOG" area="c2">
        <a href="/blog" aria-label="ブログ一覧へ">
          <BlogMotif />
        </a>
      </CardLayout>
      <CardLayout title="CAREER" area="c8">
        <Career />
      </CardLayout>
      <CardLayout title="MY SKILLS" area="c4">
        <MySkill />
      </CardLayout>
      <CardLayout title="WORKS" area="c5">
        <KeyboardMotif />
      </CardLayout>
      <CardLayout title="SNS" area="c7">
        <SnsLinks />
      </CardLayout>
    </div>
  </main>
</Layout>
