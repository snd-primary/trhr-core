---
import { css } from "styled-system/css";
import PageLayout from "src/layouts/PageLayout.astro";
import PostList from "src/components/content/PostList.astro";
import MemoCard from "src/components/content/MemoCard.astro";
import { getMemos, getPosts } from "src/lib/content";

export const prerender = true;

const LATEST_POSTS = 5;
const LATEST_MEMOS = 5;

const posts = (await getPosts()).slice(0, LATEST_POSTS);
const memos = (await getMemos()).slice(0, LATEST_MEMOS);

const sectionStyles = css({
  display: "grid",
  gap: 4
});

const sectionHeaderStyles = css({
  display: "flex",
  alignItems: "baseline",
  justifyContent: "space-between",
  gap: 4
});

const sectionTitleStyles = css({
  fontSize: "xl",
  fontWeight: "bold",
  letterSpacing: "tight"
});

const moreLinkStyles = css({
  fontSize: "sm",
  color: "primary",
  textDecoration: "none",
  _hover: { textDecoration: "underline" }
});

const introStyles = css({
  fontSize: "sm",
  color: "mutedForeground"
});

const emptyStyles = css({
  fontSize: "sm",
  color: "mutedForeground"
});

const memoListStyles = css({
  display: "grid",
  gap: 3
});
---

<PageLayout pageTitle="TRHR" showTitle={false}>
  <div class={css({ display: "grid", gap: 12 })}>
    <p class={introStyles}>
      フロントエンドエンジニア TRHR
      のブログ。技術記事と、日々のメモを置いています。
      <a href="/about" class={moreLinkStyles}>
        about me →
      </a>
    </p>

    <section class={sectionStyles}>
      <div class={sectionHeaderStyles}>
        <h2 class={sectionTitleStyles}>BLOG</h2>
        <a href="/blog" class={moreLinkStyles}>
          すべての記事 →
        </a>
      </div>
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class={emptyStyles}>まだ記事がありません。</p>
      )}
    </section>

    <section class={sectionStyles}>
      <div class={sectionHeaderStyles}>
        <h2 class={sectionTitleStyles}>MEMO</h2>
        <a href="/memos" class={moreLinkStyles}>
          すべてのメモ →
        </a>
      </div>
      {memos.length > 0 ? (
        <div class={memoListStyles}>
          {memos.map((memo) => (
            <MemoCard memo={memo} />
          ))}
        </div>
      ) : (
        <p class={emptyStyles}>まだメモがありません。</p>
      )}
    </section>
  </div>
</PageLayout>
