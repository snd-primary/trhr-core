---
import { css } from "styled-system/css";
import PageLayout from "src/layouts/PageLayout.astro";
import PostList from "src/components/content/PostList.astro";
import MemoCard from "src/components/content/MemoCard.astro";
import { getAllTags, getMemos, getPosts } from "src/lib/content";

export const prerender = true;

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;

const posts = (await getPosts()).filter((p) => p.data.tags.includes(tag));
const memos = (await getMemos()).filter((m) => m.data.tags.includes(tag));

const sectionTitleStyles = css({
  fontSize: "lg",
  fontWeight: "bold"
});
---

<PageLayout
  pageTitle={`#${tag}`}
  description={`タグ「${tag}」の記事とメモ`}
  breadcrumbs={[{ label: `#${tag}` }]}
>
  <div class={css({ display: "grid", gap: 10 })}>
    {posts.length > 0 && (
      <section class={css({ display: "grid", gap: 3 })}>
        <h2 class={sectionTitleStyles}>BLOG</h2>
        <PostList posts={posts} />
      </section>
    )}
    {memos.length > 0 && (
      <section class={css({ display: "grid", gap: 3 })}>
        <h2 class={sectionTitleStyles}>MEMO</h2>
        {memos.map((memo) => (
          <MemoCard memo={memo} />
        ))}
      </section>
    )}
  </div>
</PageLayout>
