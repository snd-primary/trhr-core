---
import MyImg from "../../assets/about.png";
import { Image } from "astro:assets";
import { css } from "styled-system/css";

import GithubIcon from "public/icon/github.svg";
import InstagramIcon from "public/icon/instagram.svg";
import XIcon from "public/icon/x.svg";
import RssIcon from "public/icon/rss.svg";

const iconToRender = [
  { component: GithubIcon, props: { href: "https://github.com/snd-primary" } },
  { component: XIcon, props: { href: "https://x.com/trhr_core" } },
  {
    component: InstagramIcon,
    props: { href: "https://www.instagram.com/1149trx/" }
  },
  { component: RssIcon, props: { href: "/rss.xml" } }
];
const iconStyle = css({
  stroke: "foreground",
  transition: "stroke 0.2s ease",
  _groupHover: {
    stroke: "primary"
  }
});

const container = css({
  display: "grid",
  gap: 4,
  w: "full",
  alignSelf: "start"
});

// アバター + 名前/肩書き/アイコン
const headerStyle = css({
  display: "flex",
  alignItems: "center",
  gap: { base: 4, "@/md": 5 },
  p: { base: 3, "@/md": 4 },
  border: "1px solid token(colors.border)",
  bgGradient: "cardGradient"
});

const imageStyle = css({
  flexShrink: 0,
  w: { base: "80px", "@/md": "96px" },
  h: "auto",
  aspectRatio: "square",
  objectFit: "cover",
  border: "1px solid token(colors.border)"
});

const identityStyle = css({
  display: "grid",
  gap: 2,
  minW: 0
});

const nameStyle = css({
  fontWeight: "bold",
  fontSize: { base: "lg", "@/md": "xl" },
  lineHeight: "tight"
});

const roleStyle = css({
  display: "flex",
  flexWrap: "wrap",
  columnGap: 3,
  fontSize: "sm",
  color: "mutedForeground"
});

const iconGroup = css({
  display: "flex",
  alignItems: "center",
  gap: 4,
  mt: 1
});

const textStyle = css({
  display: "grid",
  gap: 2,
  fontSize: { base: "medium", md: "sm" },
  lineHeight: "relaxed",
  wordBreak: "break-all",
  bgGradient: "cardGradient",
  w: "full",
  border: "1px solid token(colors.border)",
  p: { base: 4, "@/md": 5 }
});
---

<div class={container}>
  <div class={headerStyle}>
    <Image
      class={imageStyle}
      src={MyImg}
      alt="プロフィール画像"
      width={192}
      height={192}
    />
    <div class={identityStyle}>
      <h3 class={nameStyle}>TRHR&nbsp;(Ari Shinoda)</h3>
      <div class={roleStyle}>
        <span>Frontend Developer</span>
        <span>/</span>
        <span>Web designer</span>
      </div>
      <div class={iconGroup}>
        {
          iconToRender.map((item) => {
            const Component = item.component;
            return (
              <a href={item.props.href} role="group">
                <Component width={24} height={24} class={iconStyle} />
              </a>
            );
          })
        }
      </div>
    </div>
  </div>

  <div class={textStyle}>
    <p>
      フロントエンドエンジニアの Ari Shinoda です。
      React / Vue と TypeScript を軸に、設計・実装からテスト、CI/CD
      まで、プロダクトを動かし続けるための仕組みづくりを含めて担当しています。
    </p>
    <p>
      Web 標準やベンダーに縛られない技術が好きで、仕組みを根っこから理解して使うことを大事にしています。
    </p>
    <p>
      個人では Web Audio や WebGL など、技術と表現が重なる領域で遊んでいます。
    </p>
  </div>
</div>
