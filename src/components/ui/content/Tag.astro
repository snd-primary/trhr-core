---
import { css } from "styled-system/css";

const workTagStyles = css({
  color: "foreground",
  borderRadius: "full",
  fontSize: "xs",
  fontWeight: "medium",
  pt: 1,
  pb: 1,
  px: 2
});

const linkStyles = css({
  textDecoration: "none",
  transition: "color 0.2s ease",
  _hover: { color: "primary" }
});

interface Props {
  tag: string;
  // 指定するとタグページへのリンクになる
  href?: string;
}

const { tag, href } = Astro.props;
---

{href ? (
  <a href={href} class={`${workTagStyles} ${linkStyles}`}>
    #{tag}
  </a>
) : (
  <span class={workTagStyles}>#{tag}</span>
)}
