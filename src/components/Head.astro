---
import { ClientRouter } from "astro:transitions";

import {
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_URL,
  SITE_LOCALE,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  SITE_TWITTER_HANDLE,
  SITE_AUTHOR,
  SITE_SOCIAL_LINKS
} from "../../site/config";
import { toPublicPath } from "src/lib/seo";

export interface Props {
  title?: string;
  description?: string;
  // サイトルートからの絶対パス、または絶対URL
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  canonicalUrl?: string;
  noindex?: boolean;
  author?: string;
  // 記事の公開日・更新日 (ISO 8601)
  publishDate?: string;
  modifiedDate?: string;
  // 記事のタグ (keywords / article:tag に使う)
  tags?: string[];
}

const {
  title: pageTitle,
  description: pageDescription,
  ogImage: pageOgImage,
  ogImageAlt,
  ogType = "website",
  canonicalUrl: pageCanonicalUrl,
  noindex = false,
  author: pageAuthor,
  publishDate,
  modifiedDate,
  tags = []
} = Astro.props;

const siteBaseUrl = Astro.site?.toString() ?? SITE_URL;
const isArticle = ogType === "article";

// <title>: ホームは "TRHR | キャッチ"、それ以外は "ページ名 | TRHR"
const seoTitle =
  pageTitle && pageTitle !== SITE_TITLE
    ? `${pageTitle} | ${SITE_TITLE}`
    : `${SITE_TITLE} | ${SITE_TAGLINE}`;
// SNS カードはサイト名を og:site_name で出すので、見出しはページ名だけにする
const ogTitle = pageTitle ?? SITE_TITLE;

const seoDescription = pageDescription || SITE_DESCRIPTION;

// クエリやハッシュを含めない正規URL
const canonical = new URL(
  pageCanonicalUrl ?? toPublicPath(Astro.url.pathname),
  siteBaseUrl
).href;

const ogImageUrl = new URL(pageOgImage ?? SITE_OG_IMAGE, siteBaseUrl).href;
const ogImageAltText = ogImageAlt ?? ogTitle;

const currentAuthor = pageAuthor || SITE_AUTHOR;

const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";

// 構造化データ (JSON-LD)
const websiteId = `${siteBaseUrl}#website`;
const personId = `${siteBaseUrl}#person`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: SITE_AUTHOR,
  url: siteBaseUrl,
  sameAs: SITE_SOCIAL_LINKS
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": websiteId,
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: siteBaseUrl,
  inLanguage: "ja",
  publisher: { "@id": personId }
};

const pageSchema = {
  "@type": isArticle ? "BlogPosting" : "WebPage",
  "@id": `${canonical}#${isArticle ? "article" : "webpage"}`,
  ...(isArticle ? { headline: ogTitle } : { name: ogTitle }),
  description: seoDescription,
  url: canonical,
  inLanguage: "ja",
  isPartOf: { "@id": websiteId },
  image: ogImageUrl,
  author: { "@id": personId },
  ...(isArticle && {
    mainEntityOfPage: canonical,
    publisher: { "@id": personId },
    ...(publishDate && { datePublished: publishDate }),
    ...((modifiedDate ?? publishDate) && {
      dateModified: modifiedDate ?? publishDate
    }),
    ...(tags.length > 0 && { keywords: tags.join(", ") })
  })
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [personSchema, websiteSchema, pageSchema]
};
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <meta name="author" content={currentAuthor} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={`${SITE_TITLE} RSS`}
    href={new URL("/rss.xml", siteBaseUrl).href}
  />

  {/* Open Graph */}
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={SITE_LOCALE} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAltText} />
  {isArticle && publishDate && (
    <meta property="article:published_time" content={publishDate} />
  )}
  {isArticle && modifiedDate && (
    <meta property="article:modified_time" content={modifiedDate} />
  )}
  {isArticle && <meta property="article:author" content={currentAuthor} />}
  {isArticle &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)}

  {/* Twitter / X */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={seoDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAltText} />
  {SITE_TWITTER_HANDLE && (
    <>
      <meta name="twitter:site" content={SITE_TWITTER_HANDLE} />
      <meta name="twitter:creator" content={SITE_TWITTER_HANDLE} />
    </>
  )}

  {/* Favicon (public/ 配下) */}
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1a1a3a" />

  {/* JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ClientRouter />

  <slot />
</head>
